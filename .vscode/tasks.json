{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IDBS: 配置 Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "IDBS: 编译 Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--parallel", "2"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "IDBS: 配置 Debug",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "IDBS: 运行",
      "type": "process",
      "command": "${workspaceFolder}/build-debug/mydb",
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "IDBS: 编译 Debug",
      "problemMatcher": [],
      "presentation": {"reveal": "always", "focus": true, "panel": "dedicated"}
    },
    {
      "label": "IDBS: 测试",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "IDBS: 编译 Debug",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
